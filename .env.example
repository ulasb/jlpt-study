# Google Analytics 4 Measurement ID (optional).
# If unset, analytics is completely disabled (nothing loads).
# For local production testing: copy to `.env.local` and fill in.
# For the deployed site: set as a repo Actions variable named VITE_GA_ID.
VITE_GA_ID=G-XXXXXXXXXX

# Google OAuth *Web application* client ID (optional).
# Enables "Sync with Google Drive" in Settings, which saves study progress to a
# private app folder in the user's Drive so they can continue on another device.
# If unset, the whole sync feature is hidden and no Google code is loaded.
# See README → "Google Drive sync" for how to create the client ID.
# For the deployed site: set as a repo Actions variable named VITE_GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
